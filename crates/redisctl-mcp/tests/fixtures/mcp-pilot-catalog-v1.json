              "type": "string"
            }
          },
          "count": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "page": {
            "$ref": "#/$defs/PageMetadata"
          }
        },
        "required": [
          "cursor",
          "keys",
          "count",
          "page"
        ],
        "title": "ScanOutput",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
