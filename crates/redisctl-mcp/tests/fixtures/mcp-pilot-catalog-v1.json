                "type": "integer",
                "format": "uint",
                "minimum": 0
              },
              "returned": {
                "type": "integer",
                "format": "uint",
                "minimum": 0
              },
              "complete": {
                "type": "boolean"
              },
              "continuation": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/PageContinuation"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "requested",
              "returned",
              "complete"
            ]
          },
          "PageContinuation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cursor": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0
              },
