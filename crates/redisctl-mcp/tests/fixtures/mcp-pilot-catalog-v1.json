    {
      "name": "redis_scan",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ScanInput",
        "type": "object",
        "properties": {
          "cursor": {
            "description": "Cursor returned by the previous scan. Start with zero.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "default": 0
          },
          "pattern": {
            "description": "Glob-style key pattern.",
            "type": "string",
            "default": "*"
          },
          "key_type": {
            "description": "Optional Redis key type filter.",
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "count": {
            "description": "Approximate number of keys Redis should inspect in this page.",
            "type": "integer",
            "format": "uint",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
