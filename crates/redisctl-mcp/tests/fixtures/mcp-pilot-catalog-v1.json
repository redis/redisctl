    {
      "name": "redis_sort",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "SortInput",
        "type": "object",
        "properties": {
          "key": {
            "description": "List, set, or sorted-set source key.",
            "type": "string"
          },
          "key_encoding": {
            "description": "Encoding of `key`.",
            "$ref": "#/$defs/InputEncoding",
            "default": "utf8"
          },
          "by": {
            "description": "Optional external-key BY pattern. Rejected on Redis Cluster because the expanded keys cannot be prevalidated.",
            "anyOf": [
              {
                "$ref": "#/$defs/SortPatternSelector"
              },
              {
                "type": "null"
              }
            ]
          },
          "get": {
            "description": "Optional external-key or `#` GET patterns.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/SortPatternSelector"
            },
            "maxItems": 64
          },
          "offset": {
            "description": "Zero-based result offset.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "default": 0
          },
          "count": {
            "description": "Maximum source elements to sort and return/store.",
            "type": "integer",
            "format": "uint",
            "minimum": 1,
            "maximum": 1000,
            "default": 100
          },
          "order": {
            "description": "Sort ascending or descending.",
            "$ref": "#/$defs/SortOrder",
            "default": "ascending"
          },
          "alpha": {
            "description": "Sort lexicographically instead of parsing numeric values.",
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "$defs": {
          "InputEncoding": {
            "type": "string",
            "enum": [
              "utf8",
              "base64"
            ]
          },
          "SortPatternSelector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/EncodedSortPattern"
              }
            ]
          },
          "EncodedSortPattern": {
            "type": "object",
            "properties": {
              "value": {
                "description": "Redis SORT BY/GET pattern.",
                "type": "string"
              },
              "encoding": {
                "description": "Encoding of `value`.",
                "$ref": "#/$defs/InputEncoding",
                "default": "utf8"
              }
            },
            "additionalProperties": false,
            "required": [
              "value"
            ]
          },
          "SortOrder": {
            "type": "string",
            "enum": [
              "ascending",
              "descending"
            ]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "key_encoding": {
            "$ref": "#/$defs/InputEncoding"
          },
          "source_exists": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "requested_count": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "get_pattern_count": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "returned": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/SortValue"
            }
          }
        },
        "required": [
          "key",
          "key_encoding",
          "source_exists",
          "offset",
          "requested_count",
          "get_pattern_count",
          "returned",
          "values"
        ],
        "title": "SortOutput",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$defs": {
          "InputEncoding": {
            "type": "string",
            "enum": [
